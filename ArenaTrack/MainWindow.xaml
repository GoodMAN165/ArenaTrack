<Window x:Class="ArenaTrack.MainWindow"
        xmlns:views="clr-namespace:ArenaTrack.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArenaTrack" Width="1200" Height="720"
        MinWidth="1000" MinHeight="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Language="ru-RU">
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="Bold"
                           Margin="24,24,24,20">
                           <Run Text="Arena" Foreground="{StaticResource TextBrush}"/><Run Text="Track" Foreground="{StaticResource AccentBrush}"/>
                </TextBlock>

                <TextBlock DockPanel.Dock="Bottom" Text="v0.1 · учебный проект"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Margin="24,0,24,16"/>

                <StackPanel>
                    <RadioButton Content="⚔  Матчи" Tag="Матчи" IsChecked="True" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton Content="🏆  Турниры" Tag="Турниры" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton Content="👥  Команды" Tag="Команды" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton Content="♞  Игроки" Tag="Игроки" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton Content="★  Избранное" Tag="Избранное" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton Content="⚙  Настройки" Tag="Настройки" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton Content="🔒  Администрирование" Tag="Администрирование" GroupName="Nav"
                        Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,20,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="PageTitle" Text="Матчи"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <Border HorizontalAlignment="Right" Width="280" Height="38"
                        CornerRadius="19" Background="{StaticResource CardBrush}">
                    <TextBox x:Name="SearchBox" Background="Transparent"
                             BorderThickness="0" Padding="16,0"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             FontSize="13"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" CornerRadius="12"
                    Background="{StaticResource CardBrush}" Padding="24">
                <ContentControl x:Name="PageHost"/>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,10,0,0"
                       Text="Последняя синхронизация: нет данных"
                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                       x:Name="SyncText"/>
        </Grid>
    </Grid>
</Window>