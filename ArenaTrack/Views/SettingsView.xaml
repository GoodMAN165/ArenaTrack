<UserControl x:Class="ArenaTrack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">

            <TextBlock Text="Уведомления" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

            <CheckBox x:Name="EnabledBox" Content="Напоминать о матчах из избранного"
                      Foreground="{StaticResource TextBrush}" FontSize="14"
                      Margin="0,0,0,16"/>

            <TextBlock Text="За сколько минут до начала (1–1440):"
                       Foreground="{StaticResource MutedBrush}" FontSize="13"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="MinutesBox" Width="120" Height="32" HorizontalAlignment="Left"
                     Background="{StaticResource SidebarBrush}"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderThickness="0" Padding="10,0"
                     VerticalContentAlignment="Center" FontSize="14"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Сохранить" Padding="18,0" Height="34"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
                <Button Content="Тестовое уведомление" Padding="18,0" Height="34"
                        Margin="10,0,0,0"
                        Background="{StaticResource HoverBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Test_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>

            <Border Height="1" Background="{StaticResource HoverBrush}" Margin="0,28,0,24"/>

            <TextBlock Text="Демонстрационные данные" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Вымышленные матчи по Valorant и шахматам для показа без подключения к сети. Они помечены «(демо)» и удаляются отдельно, реальные данные не затрагиваются."/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Загрузить демо-данные" Padding="18,0" Height="34"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="LoadDemo_Click"/>
                <Button Content="Удалить демо-данные" Padding="18,0" Height="34"
                        Margin="10,0,0,0"
                        Background="{StaticResource HoverBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="RemoveDemo_Click"/>
            </StackPanel>

            <TextBlock x:Name="DemoStatus" Margin="0,14,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>