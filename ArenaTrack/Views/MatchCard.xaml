<UserControl x:Class="ArenaTrack.Views.MatchCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Content" Value="☆"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Добавить в избранное"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Content" Value="★"/>
                    <Setter Property="Foreground" Value="#F5B301"/>
                    <Setter Property="ToolTip" Value="Убрать из избранного"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5B301"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="{Binding LocalTime}"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <TextBlock Text="{Binding Game}"
                           Foreground="{StaticResource AccentBrush}" FontSize="11"/>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Team1}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ScoreText}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Team2}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Border Grid.Row="0" Grid.Column="4"
                    CornerRadius="10" Padding="10,3"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Live">
                                <Setter Property="Background" Value="#1F9D55"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
            </Border>

            
            <Button Grid.Row="0" Grid.Column="5" Style="{StaticResource StarButton}"
                    Click="Star_Click"/>

            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding TournamentName}"
                       ToolTip="{Binding TournamentName}"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Margin="0,6,0,0" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>