<UserControl x:Class="ArenaTrack.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>

        
        <StackPanel x:Name="LoginPanel" MaxWidth="360" HorizontalAlignment="Left">
            <TextBlock x:Name="LoginTitle" TextWrapping="Wrap" FontSize="15"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

            <PasswordBox x:Name="PwdBox" Height="34" Margin="0,0,0,10"
                         Background="{StaticResource SidebarBrush}"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         BorderThickness="0" Padding="10,0"
                         VerticalContentAlignment="Center" FontSize="14"/>
            <PasswordBox x:Name="Pwd2Box" Height="34" Margin="0,0,0,10"
                         Background="{StaticResource SidebarBrush}"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         BorderThickness="0" Padding="10,0"
                         VerticalContentAlignment="Center" FontSize="14"
                         ToolTip="Повторите пароль"/>

            <Button x:Name="LoginButton" Height="34" HorizontalAlignment="Left" Padding="22,0"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" IsDefault="True" Click="Login_Click"/>

            <TextBlock x:Name="LoginStatus" Margin="0,12,0,0" FontSize="12"
                       Foreground="#E74C3C" TextWrapping="Wrap"/>
        </StackPanel>

        
        <ScrollViewer x:Name="AdminPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                
                <TextBlock Text="Источники данных" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                <CheckBox x:Name="ChessBox" Content="Шахматы (Lichess)" Click="Source_Click"
                          Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,8"/>
                <CheckBox x:Name="ValorantBox" Content="Valorant (PandaScore)" Click="Source_Click"
                          Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,8"/>

                <Border Height="1" Background="{StaticResource HoverBrush}" Margin="0,18,0,18"/>

                
                <TextBlock Text="API-ключ PandaScore" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="KeyStatus" FontSize="13" Margin="0,0,0,8"
                           Foreground="{StaticResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <PasswordBox x:Name="KeyBox" Width="320" Height="34"
                                 Background="{StaticResource SidebarBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 BorderThickness="0" Padding="10,0"
                                 VerticalContentAlignment="Center" FontSize="14"/>
                    <Button Content="Сохранить ключ" Padding="18,0" Height="34" Margin="10,0,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="SaveKey_Click"/>
                </StackPanel>

                <Border Height="1" Background="{StaticResource HoverBrush}" Margin="0,18,0,18"/>

                
                <TextBlock Text="Резервная копия базы данных" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Создать копию…" Padding="18,0" Height="34"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="Backup_Click"/>
                    <Button Content="Восстановить из копии…" Padding="18,0" Height="34" Margin="10,0,0,0"
                            Background="{StaticResource HoverBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="Restore_Click"/>
                </StackPanel>
                <TextBlock x:Name="BackupStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"/>

                <Border Height="1" Background="{StaticResource HoverBrush}" Margin="0,18,0,18"/>

                
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Журнал синхронизации и ошибок" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Обновить" Padding="14,0" Height="28"
                                Background="{StaticResource HoverBrush}" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="RefreshLog_Click"/>
                        <Button Content="Очистить" Padding="14,0" Height="28" Margin="8,0,0,0"
                                Background="{StaticResource HoverBrush}" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="ClearLog_Click"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource SidebarBrush}" CornerRadius="10" Padding="12">
                    <ListBox x:Name="LogList" Height="260" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LocalTime}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Level}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="#F5B301"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Button Content="Заблокировать раздел" Padding="18,0" Height="34"
                        HorizontalAlignment="Left" Margin="0,20,0,20"
                        Background="{StaticResource HoverBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Lock_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>