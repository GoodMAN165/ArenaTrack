<UserControl x:Class="ArenaTrack.Views.TournamentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <ListBox x:Name="TournamentList" Background="Transparent" BorderThickness="0"
                 SelectionChanged="TournamentList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Game}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        
        <Border Grid.Column="2" Background="{StaticResource SidebarBrush}"
                CornerRadius="12" Padding="24">
            <Grid>
                <TextBlock x:Name="Placeholder" Text="Выберите турнир слева"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="Card" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CardName" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CardGame" Grid.Row="1" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,12"/>
                    <TextBlock x:Name="CardDates" Grid.Row="2" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CardPrize" Grid.Row="3" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                    <ListBox x:Name="CardMatches" Grid.Row="4" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LocalTime}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Team1}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Team2}"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>