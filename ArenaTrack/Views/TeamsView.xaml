<UserControl x:Class="ArenaTrack.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="NameList" Background="Transparent" BorderThickness="0"
                 SelectionChanged="NameList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="4,6" FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="2" Background="{StaticResource SidebarBrush}"
                CornerRadius="12" Padding="24">
            <Grid>
                <TextBlock x:Name="Placeholder"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="Card" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CardName" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CardGame" Grid.Row="1" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,16"/>

                    <ItemsControl x:Name="StatsList" Grid.Row="2" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                                        Padding="12,10" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="RosterPanel" Grid.Row="3" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock Text="Состав" FontSize="14" FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="RosterList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,8,8" ToolTip="{Binding FullName}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nickname}" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding FullName}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding Country}" FontSize="10"
                                   Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ListBox x:Name="RowsList" Grid.Row="4" Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5" ToolTip="{Binding Tournament}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Opponent}"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Score}"
                                               HorizontalAlignment="Center" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Result}"
                                               HorizontalAlignment="Right" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Result}" Value="Победа">
                                                        <Setter Property="Foreground" Value="#2ECC71"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result}" Value="Поражение">
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>